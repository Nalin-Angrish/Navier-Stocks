# NATS
NATS_URL=nats://localhost:4222

# Groww API
# Either set GROWW_ACCESS_TOKEN directly (expires daily at 6AM IST),
# or set GROWW_API_KEY + GROWW_API_SECRET for auto-refresh via POST /token/api/access.
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_BASE_URL=https://api.groww.in/v1
GROWW_TOKEN_URL=https://api.groww.in/v1/token/api/access
GROWW_FEED_URL=wss://api.groww.in/v1/feed

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=navier
PG_PASSWORD=devpassword
PG_DATABASE=navier_stocks
PG_SSLMODE=disable

# Sentiment Analyst
# Ticker universe the Sentiment Analyst watches. Leave empty to mirror the
# Quantitative Scout's universe (QUANT_UNIVERSE or its default).
SENTIMENT_UNIVERSE=
SENTIMENT_INTERVAL=15m   # scrape-and-score cycle cadence
SENTIMENT_STALENESS=60m  # skip LLM while a score is younger than this

# LLM provider used by the Sentiment Analyst (openai | ollama)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=llama3
LLM_TIMEOUT=60s
